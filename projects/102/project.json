{"projectInfo":{"name":"QinQ基本组网配置举例","path":"hcl_tgyhpm","visibility":2,"categoryId":99,"introduction":"两个分支机构Site 1和Site 2通过运营商网络进行通信，PE 1和PE 2为运营商网络的边缘设备，且二者通过TPID值为0x8200的运营商网络设备进行连接，Site 1和Site 2需要利用运营商提供的VLAN 100使公司A的两个分支机构之间实现互通。","label":["QinQ","VLAN"]},"deviceInfoList":[{"resourceName":"SITE2","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SITE2.cfg"},{"resourceName":"PE1","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\PE1.cfg"},{"resourceName":"PE2","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\PE2.cfg"},{"resourceName":"SITE1","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SITE1.cfg"}]}