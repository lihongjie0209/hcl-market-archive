        x = -195.0
        y = -182.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 4]]
        text = "本功能只适用于EBGP对等体和对等体组。\n仅在设备使用虚拟AS号与对等体建立会话时，prepend-fake-as和prepend-global-as参数的配置才会生效。\n\ndual-as：允许本地路由器通过真实AS号或虚拟AS号与对端建立连接。\nprepend-fake-as：从指定对等体接收路由时在AS_Path列表中增加虚拟AS号。缺省对外发布的是真实AS，除了Fake的peer是虚拟的。\nprepend-global-as：向指定对等体发送路由时在AS_Path列表中增加真实AS号。"
        x = -639.0
        y = -14.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
