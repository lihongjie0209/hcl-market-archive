{"projectInfo":{"name":"SNMP","path":"snmp_test","visibility":2,"categoryId":5886,"introduction":"SNMP（Simple Network Management Protocol，简单网络管理协议）广泛用于网络设备的远程管理和操作。SNMP允许管理员通过NMS对网络上不同厂商、不同物理特性、采用不同互联技术的设备进行管理，包括状态监控、数据采集和故障处理。NMS与Agent相连，NMS通过SNMPv2c对Agent进行监控管理。","label":["SNMP"]},"deviceInfoList":[{"resourceName":"SW","resourceCategory":"交换机","resourceModel":"S5820V2-54QS-GE","resourceVersion":"CMW7.1.075-A7571","configPath":"DeviceConfig\\SW.cfg"},{"resourceName":"PC_4","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\PC_4.cfg"},{"resourceName":"PC_5","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\PC_5.cfg"},{"resourceName":"RTA","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RTA.cfg"},{"resourceName":"PC_3","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\PC_3.cfg"}]}