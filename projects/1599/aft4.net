    [[NOTE 3]]
        text = "10.1.1.0/24"
        x = -430.0
        y = -13.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 4]]
        text = "Internet已经升级到了IPv6，但是某公司内部网络仍然是IPv4网络。\n而该公司内部网络的10.1.1.0/24网段的用户仍需要访问IPv6 Internet中的服务器，其他用户不能访问。\n为满足上述要求，本例中使用如下方式实现：\n·使用IPv4到IPv6源地址动态地址转换策略，将IPv4报文的源地址转换为IPv6地址。\n·通过IPv6到IPv4的源地址静态转换策略为IPv6 Internet上服务器的IPv6地址指定一个对应的IPv4地址，\nRouter收到发往该IPv4地址的报文时将其转换为对应的IPv6地址。"
        x = -538.0
        y = 195.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 5]]
        text = "GE_0/1"
        x = 65.0
        y = 25.0
        interface = Router GE_0/1
        font = "Arial,10,-1,5,50,0,0,0,0,0"
        z = 6.0
