        z = 6.0
    [[NOTE 3]]
        text = "VPDN（Virtual Private Dial Network，虚拟专有拨号网络）业务是在宽带互联网基础上开放的基于拨号方式的虚拟专有网络业务，\n利用L2TP或GRE技术为物联网客户构建与公众互联网隔离的虚拟专用网络，满足客户的物联网无线终端访问客户内部网络的需求。\n目前大部分VPDN业务都采用L2TP技术实现。\n在运营商网络中，VPDN用户通过拨号的方式接入，由AAA服务器根据账号给BRAS下发LNS IP等参数，\nBRAS作为LAC和LNS端建立L2TP隧道，实现终端用户访问本企业/封闭站点的虚拟专用网络。\nPPP用户通过LAC接入LNS，在LAC和LNS之间建立L2TP隧道，以便用户通过该L2TP隧道访问公司总部。\n"
        x = -687.0
        y = 65.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
