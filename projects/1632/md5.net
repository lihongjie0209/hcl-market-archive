[GNS3-DATA]
    [[NOTE 1]]
        text = "通过为BGP对等体配置BGP的MD5认证，可以在以下两方面提高BGP的安全性：\n·           为BGP建立TCP连接时进行MD5认证，只有两台路由器配置的密钥相同时，才能建立TCP连接，\n从而避免与非法的BGP路由器建立TCP连接。\n·           传递BGP报文时，对封装BGP报文的TCP报文段进行MD5运算，从而保证BGP报文不会被篡改。"
        x = -484.0
        y = 110.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 2]]
        text = "BGP MD5认证"
