[GNS3-DATA]
    [[NOTE 1]]
        text = "为了避免路由信息外泄或者非法者对设备进行恶意攻击，可以利用IPsec安全隧道对IPv6 BGP报文进行保护。\n通过IPsec提供的数据机密性、完整性、数据源认证等功能，确保IPv6 BGP报文不会被侦听或恶意篡改，\n并避免非法者构造IPv6 BGP报文对设备进行攻击。\n\n在互为IPv6 BGP邻居的两台设备上都配置通过IPsec保护IPv6 BGP报文后，一端设备在发送IPv6 BGP报文时通过\nIPsec对报文进行加封装，另一端设备接收到报文后，通过IPsec对报文进行解封装。如果解封装成功，\n则接收该报文，正常建立IPv6 BGP对等体关系或学习IPv6 BGP路由；\n如果设备接收到不受IPsec保护的IPv6 BGP报文，或IPv6 BGP报文解封装失败，则会丢弃该报文。"
        x = -614.0
        y = 184.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 2]]
        text = "AS 65009"
        x = 92.0
        y = -107.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 3]]
        text = "通过IPsec保护IPv6 BGP报文配置"
        x = -262.0
        y = -192.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 4]]
        text = "AS 65008"
        x = -317.0
        y = -105.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 5]]
        text = "3::/64"
        x = 75.0
        y = -75.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 6]]
        text = "· Router A、Router B和Router C三台路由器之间运行IPv6 BGP交互路由信息。\nRouter A和Router B之间建立IBGP连接，Router B和Router C之间建立EBGP连接。\n· 为了提高安全性，配置通过IPsec对IPv6 BGP报文进行保护。"
        x = -471.0
        y = 64.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
