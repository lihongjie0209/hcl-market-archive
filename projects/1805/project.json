{"projectInfo":{"name":"L2TP多实例配置举例","path":"l2tpmul","visibility":2,"categoryId":53,"introduction":"多个企业共用Router C作为LNS，不同的企业用户分别连接Router A和Router B与各自的总部site1 和site2 进行通讯。现要求：在Router C上配置L2TP多实例功能，使其能够为Router A和Router B同时提供L2TP接入服务，实现不同企业的用户能够远程访问企业内部网络。","label":["L2TP"]},"deviceInfoList":[{"resourceName":"SW","resourceCategory":"交换机","resourceModel":"S5820V2-54QS-GE","resourceVersion":"CMW7.1.075-A7571","configPath":"DeviceConfig\\SW.cfg"},{"resourceName":"site-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\site-1.cfg"},{"resourceName":"site-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\site-2.cfg"},{"resourceName":"Router-A","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\Router-A.cfg"},{"resourceName":"Router-B","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\Router-B.cfg"},{"resourceName":"Router-C","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\Router-C.cfg"}]}