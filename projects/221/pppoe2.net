        z = 6.0
    [[NOTE 2]]
        text = "PPPoE Client永久在线模式配置举例"
        x = -291.0
        y = -367.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 3]]
        text = "PPPoE Server"
        x = -322.0
        y = -264.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 4]]
        text = "[RouterB] interface dialer 1\n[RouterB-Dialer1] dialer bundle enable\n# 配置Dialer1接口通过协商获取IP地址。\n[RouterB-Dialer1] ip address ppp-negotiate\n[RouterB-Dialer1] quit\n# 配置一个PPPoE会话，该会话对应Dialer bundle 1（Dialer bundle 1对应Dialer1接口）。\n[RouterB] interface gigabitethernet 0/0\n[RouterB-GigabitEthernet1/0/1] pppoe-client dial-bundle-number 1\n[RouterB-GigabitEthernet1/0/1] quit\n\n# 配置PPPoE Client工作在永久在线模式。\n[RouterB] interface dialer 1\n[RouterB-Dialer1] dialer timer idle 0\n# 配置DDR自动拨号的间隔时间为60秒。\n[RouterB-Dialer1] dialer timer autodial 60\n[RouterB-Dialer1] quit"
        x = -449.0
        y = -86.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
    [[NOTE 5]]
        text = "GE_0/0"
        x = -70.0
        y = -5.0
        interface = Client-1 GE_0/0
        font = "Arial,10,-1,5,50,0,0,0,0,0"
        z = 6.0
    [[NOTE 6]]
