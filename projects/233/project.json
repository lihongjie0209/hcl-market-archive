{"projectInfo":{"name":"IPv6 over IPv4手动隧道典型配置举例","path":"ipv6ipv4","visibility":2,"categoryId":34,"introduction":"两个IPv6网络分别通过Router A和Router B与IPv4网络连接，要求在Router A和Router B之间建立IPv6 over IPv4隧道，使两个IPv6网络可以互通。由于隧道终点的IPv4地址不能从IPv6报文的目的地址中自动获取，因此，需要配置IPv6 over IPv4手动隧道。","label":["IPv6 over IPv4","隧道"]},"deviceInfoList":[{"resourceName":"RTA","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RTA.cfg"},{"resourceName":"RTB","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RTB.cfg"},{"resourceName":"PC-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PC-1.cfg"},{"resourceName":"PC-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PC-2.cfg"}]}