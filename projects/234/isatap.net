autostart = False
version = 2.1.1
[vbox 127.0.0.1:16600]
    workingdir = None
    udp = 16000
    [[MSR36-20 Router]]
        image = .
        device_id = 2
        bridge_mac = 3c-32-25-04-02-00
        slot0 = MSR36 512
        GE_0/0 = IPv6-Host GE_0/0
        GE_0/1 = NIC:VirtualBox Host-Only Ethernet Adapter
        x = -90.0
        y = -94.0
        z = 5.0
    [[MSR36-20 IPv6-Host]]
        image = .
        device_id = 1
        bridge_mac = 3c-32-1d-0e-01-00
        slot0 = MSR36 512
        GE_0/0 = Router GE_0/0
        x = -320.0
        y = -94.0
        z = 5.0
