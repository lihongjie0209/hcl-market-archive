{"projectInfo":{"name":"配置MPLS L3VPN示例","path":"mpls_l3vpn","visibility":2,"categoryId":44,"introduction":"CE 1、CE 3属于VPN 1，CE 2、CE 4属于VPN 2；VPN 1使用的Route Target属性为111:1，VPN 2使用的Route Target属性为222:2。不同VPN用户之间不能互相访问；CE与PE之间配置EBGP交换VPN路由信息；PE与PE之间配置OSPF实现PE内部的互通、配置MP-IBGP交换VPN路由信息。","label":["MPLS","L3VPN"]},"deviceInfoList":[{"resourceName":"PE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-2.cfg"},{"resourceName":"PE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-1.cfg"},{"resourceName":"CE-4","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-4.cfg"},{"resourceName":"CE-3","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-3.cfg"},{"resourceName":"CE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-2.cfg"},{"resourceName":"CE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-1.cfg"},{"resourceName":"P","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\P.cfg"}]}