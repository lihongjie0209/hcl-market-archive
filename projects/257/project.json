{"projectInfo":{"name":"配置MPLS跨域VPN-OptionA方式示例","path":"vpn_optiona","visibility":2,"categoryId":44,"introduction":"CE 1和CE 2属于同一个VPN。CE 1通过AS 100的PE 1接入，CE 2通过AS 200的PE 2接入。采用OptionA方式实现跨域的MPLS L3VPN，即，采用VRF-to-VRF方式管理VPN路由。同一个AS内部的MPLS骨干网使用OSPF作为IGP。","label":["MPLS","跨域","OptionA"]},"deviceInfoList":[{"resourceName":"PE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-2.cfg"},{"resourceName":"PE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-1.cfg"},{"resourceName":"CE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-2.cfg"},{"resourceName":"CE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-1.cfg"},{"resourceName":"ASBR-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\ASBR-1.cfg"},{"resourceName":"ASBR-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\ASBR-2.cfg"}]}