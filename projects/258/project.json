{"projectInfo":{"name":"配置MPLS跨域VPN-OptionB方式示例","path":"vpn_optionb","visibility":2,"categoryId":44,"introduction":"Site 1和Site 2属于同一个VPN，Site 1的CE 1通过AS 100的PE 1接入，Site 2的CE 2通过AS 600的PE 2接入；同一自治系统内的PE设备之间运行IS-IS作为IGP；PE 1与ASBR-PE 1间通过MP-IBGP交换VPNv4路由；PE 2与ASBR-PE 2间通过MP-IBGP交换VPNv4路由；ASBR-PE 1与ASBR-PE 2间通过MP-EBGP交换VPNv4路由；ASBR上不对接收的VPNv4路由进行Route Target过滤。","label":["MPLS","跨域","OptionB"]},"deviceInfoList":[{"resourceName":"PE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-1.cfg"},{"resourceName":"CE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-2.cfg"},{"resourceName":"CE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\CE-1.cfg"},{"resourceName":"ASBR-PE1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\ASBR-PE1.cfg"},{"resourceName":"PE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-2.cfg"},{"resourceName":"ASBR-PE2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\ASBR-PE2.cfg"}]}