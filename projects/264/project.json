{"projectInfo":{"name":"VPLS LDP方式配置举例","path":"ldp_vpls","visibility":2,"categoryId":45,"introduction":"CE 1、CE 2和CE 3分属于3个站点，同属于VPN 1；站点1、站点2和站点3通过以太网接口的方式接入PE 1、PE 2和PE 3；在各个PE上配置VPLS，使得PE之间采用LDP信令协议建立PW，通过PW连接各个CE。","label":["VPLS","LDP"]},"deviceInfoList":[{"resourceName":"PE-2","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-2.cfg"},{"resourceName":"PE-3","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-3.cfg"},{"resourceName":"CE-3","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\CE-3.cfg"},{"resourceName":"CE-2","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\CE-2.cfg"},{"resourceName":"CE-1","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\CE-1.cfg"},{"resourceName":"PE-1","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\PE-1.cfg"}]}