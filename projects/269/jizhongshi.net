    [[NOTE 11]]
        text = "Router A、Router B为与服务器连接的VTEP设备；Router C为与广域网连接的集中式EVPN网关设备；\nRouter D为RR，负责在路由器之间反射BGP路由。\n虚拟机VM 1和VM 3属于VXLAN 10；VM 2和VM 4属于VXLAN 20。\n相同VXLAN之间可以二层互通，不同VXLAN之间、VXLAN与广域网之间可以通过集中式EVPN网关互通。"
        x = -599.0
        y = 228.0
        font = "Arial,14,-1,5,75,0,0,0,0,0"
        z = 6.0
