{"projectInfo":{"name":"VRRP、Track与控制报文方式的BFD会话联动配置举例（Backup监视Master）","path":"vrrpandtrackzz","visibility":2,"categoryId":121,"introduction":"当Switch A正常工作时，Host A发送给Host B的报文通过Switch A转发；Master出现故障时，Backup若只依赖于VRRP通告报文的超时时间来判断是否应该抢占，切换时间一般在3秒～4秒之间，无法达到秒级以下的切换速度；如果Backup通过控制报文方式的BFD会话检测Master的运行状态，则能够在毫秒级的时间内发现Master的故障，立即抢占成为Master，加快切换速度。","label":["VRRP","Track","BFD"]},"deviceInfoList":[{"resourceName":"SWA","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWA.cfg"},{"resourceName":"S6850_1","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\S6850_1.cfg"},{"resourceName":"SWC","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWC.cfg"},{"resourceName":"SWB","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWB.cfg"},{"resourceName":"SWD","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWD.cfg"},{"resourceName":"S6850_6","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\S6850_6.cfg"},{"resourceName":"HOST2","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\HOST2.cfg"},{"resourceName":"HOST1","resourceCategory":"终端设备","resourceModel":"PC","resourceVersion":"","configPath":"DeviceConfig\\HOST1.cfg"}]}