{"projectInfo":{"name":"OSPF引入自治系统外部路由配置举例交换","path":"ospfzizilq","visibility":2,"categoryId":6281,"introduction":"所有的交换机都运行ospf，整个自治系统划分为3个区域，其中SWA和SWB作为ABR来转发区域之间的路由，在SWC上配置为ASBR引入外部路由（静态路由），且路由信息可正确在AS内传播。","label":["OSPF","外部路由"]},"deviceInfoList":[{"resourceName":"SWA","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWA.cfg"},{"resourceName":"SWB","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWB.cfg"},{"resourceName":"SWD","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWD.cfg"},{"resourceName":"S6850_6","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\S6850_6.cfg"},{"resourceName":"S6850_5","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\S6850_5.cfg"},{"resourceName":"SWC","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWC.cfg"}]}