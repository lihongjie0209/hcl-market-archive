{"projectInfo":{"name":"集中式VXLAN IP网关保护组配置举例","path":"hcl_izwuqq","visibility":2,"categoryId":8406,"introduction":"Switch A、Switch B 为与服务器连接的 VTEP 设备，Switch C 和 Switch D 为与广域网连接的集中式 VXLAN IP 网关设备。虚拟机 VM 1 属于 VXLAN 10，虚拟机 VM 4 属于 VXLAN 20。通过 VXLAN IP 网关保护组实现 Switch C 和 Switch D 能够同时对虚拟机的跨网络报文进行三层转发，同时实现网关设备的备份。","label":["集中式VXLAN IP 网关","网关保护组"]},"deviceInfoList":[{"resourceName":"SWA","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWA.cfg"},{"resourceName":"SWC","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWC.cfg"},{"resourceName":"SWB","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWB.cfg"},{"resourceName":"SWE","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWE.cfg"},{"resourceName":"SWD","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWD.cfg"},{"resourceName":"L3 network","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\L3 network.cfg"},{"resourceName":"VM4","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\VM4.cfg"},{"resourceName":"VM1","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\VM1.cfg"}]}