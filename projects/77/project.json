{"projectInfo":{"name":"OSPF NSSA区域配置举例","path":"ospf1","visibility":2,"categoryId":38,"introduction":"所有的路由器都运行OSPF，整个自治系统划分为3个区域。其中Router A和Router B作为ABR来转发区域之间的路由。要求将Area1配置为NSSA区域，同时将Router C配置为ASBR引入外部路由（静态路由），且路由信息可正确的在AS内传播。","label":["OSPF","NSSA"]},"deviceInfoList":[{"resourceName":"RouterB","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RouterB.cfg"},{"resourceName":"RouterC","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RouterC.cfg"},{"resourceName":"RouterA","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RouterA.cfg"},{"resourceName":"RouterD","resourceCategory":"路由器","resourceModel":"MSR36-20","resourceVersion":"CMW7.1.064-R0821P11","configPath":"DeviceConfig\\RouterD.cfg"}]}