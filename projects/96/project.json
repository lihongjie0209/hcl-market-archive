{"projectInfo":{"name":"EVPN和DRNI二层转发配置举例","path":"evpndrni","visibility":2,"categoryId":112,"introduction":"Switch A、Switch B、Switch D为与服务器连接的VTEP设备，Switch A和Switch B分布式聚合为一台虚拟VTEP设备，通过IPL（Intra-Portal Link，内部控制链路）同步MAC地址和ARP信息。Switch C作为路由反射器在Switch A、Switch B、Switch D之间反射路由。虚拟机sever1、sever 4和sever 3同属于VXLAN 10，通过EVPN实现不同站点间的二层互通。","label":["EVPN","VXLAN","L2vpn","DRNI"]},"deviceInfoList":[{"resourceName":"SWA","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWA.cfg"},{"resourceName":"SWC","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWC.cfg"},{"resourceName":"SWB","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWB.cfg"},{"resourceName":"Server1","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\Server1.cfg"},{"resourceName":"Server2","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\Server2.cfg"},{"resourceName":"SWD","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\SWD.cfg"},{"resourceName":"Server4","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\Server4.cfg"},{"resourceName":"Server3","resourceCategory":"交换机","resourceModel":"S6850","resourceVersion":"CMW7.1.070-A7170","configPath":"DeviceConfig\\Server3.cfg"}]}